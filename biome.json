{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "html": {
        "formatter": {
            "enabled": false
        },
        "experimentalFullSupportEnabled": true
    },
    "files": {
        "includes": ["**", "!!**/node_modules", "!!**/dist", "!!**/.astro"],
        "ignoreUnknown": false
    },
    "formatter": {
        "enabled": false
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnusedImports": "off",
                "noUnusedVariables": "off"
            },
            "style": {
                "useConst": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["*.svelte", "src/**/*.svelte"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedImports": "off",
                        "noUnusedVariables": "off"
                    },
                    "style": {
                        "useConst": "off"
                    }
                }
            }
        }
    ]
}
