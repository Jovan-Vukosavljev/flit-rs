---
import Counter from '../components/Counter.svelte';
import Layout from '../layouts/Layout.astro';
---

<Layout title='Flit'>
    <main
        class='mx-auto flex min-h-screen max-w-5xl flex-col justify-center px-6 py-16 sm:px-12'
    >
        <p
            class='mb-8 flex items-center gap-2 font-mono text-xs uppercase tracking-widest'
        >
            <span
                class='i-lucide-sprout size-5 text-emerald-700'
                aria-hidden='true'></span>
            Flit / Ready to build
        </p>
        <h1 class='font-serif text-7xl tracking-tight sm:text-9xl'>
            Start here.
        </h1>
        <p class='mt-6 max-w-lg text-lg leading-relaxed text-stone-600'>
            Astro pages. Svelte interactions. Your next idea.
        </p>
        <div class='mt-10 border-t border-stone-300 pt-8'>
            <Counter client:load />
        </div>
        <p class='mt-12 font-mono text-xs leading-6 text-stone-500'>
            Bun · Astro · Svelte · UnoCSS Wind4 · Iconify<br />
            Edit src/pages/index.astro to get started.
        </p>
    </main>
</Layout>
