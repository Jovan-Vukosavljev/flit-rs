---
import Approach from '../../components/Approach.astro';
import Contact from '../../components/Contact.astro';
import Drone from '../../components/Drone.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import type { Locale } from '../../config/site';
import { translations } from '../../i18n';

import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
    return [
        { params: { lang: 'sr' }, props: { locale: 'sr' } },
        { params: { lang: 'en' }, props: { locale: 'en' } },
    ];
}
interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const copy = translations[locale];
---

<Layout locale={locale} copy={copy}>
    <Header locale={locale} copy={copy} />
    <main id='main'>
        <Hero copy={copy} />
        <Services copy={copy.services} />
        <Approach copy={copy.approach} />
        <Drone locale={locale} copy={copy.drone} />
        <Faq copy={copy.faq} />
        <Contact locale={locale} copy={copy.contact} />
    </main>
    <Footer locale={locale} copy={copy.footer} />
</Layout>
