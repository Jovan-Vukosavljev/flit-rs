---
import type { Copy } from '../i18n';

interface Props {
    copy: Copy['services'];
}
const { copy } = Astro.props;
const icons = ['i-lucide-headset', 'i-lucide-monitor-cog', 'i-lucide-network'];
---

<section id='services' class='shell section-space' aria-labelledby='services-heading'>
    <p class='eyebrow'>{copy.eyebrow}</p>
    <div class='section-intro'>
        <h2 id='services-heading' class='section-title'>{copy.heading}</h2><p
            class='body-copy'
        >
            {copy.body}
        </p>
    </div>
    <div class='services-grid'>
        {
            copy.items.map((service, index) => (
                <article class='service'>
                    <div class='service-top'>
                        <span
                            class:list={['service-icon size-7', icons[index]]}
                            aria-hidden='true'
                        />
                        <span class='service-number'>0{index + 1}</span>
                    </div>

                    <h3>{service.title}</h3>
                    <p class='body-copy'>{service.body}</p>

                    <ul>
                        {service.points.map((point) => (
                            <li>
                                <span
                                    class='i-lucide-check size-3.5 shrink-0'
                                    aria-hidden='true'
                                />
                                {point}
                            </li>
                        ))}
                    </ul>
                    <div class='mode'>
                        <span>{service.mode}</span>
                        <span
                            class='i-lucide-arrow-up-right size-4'
                            aria-hidden='true'
                        />
                    </div>
                </article>
            ))
        }
    </div>
</section>
<style>
    .section-intro {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 60px;
        margin-top: 18px;
    }
    .section-intro p {
        max-width: 360px;
    }
    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-top: 44px;
    }
    .service {
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--line);
        padding: 30px 28px 22px;
        border-radius: 5px;
    }
    .service-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 35px;
    }
    .service-icon {
        color: var(--accent);
    }
    .service-number {
        color: var(--muted);
        font-size: 11px;
    }
    h3 {
        font-weight: 600;
        font-size: 21px;
        letter-spacing: -0.025em;
        margin-bottom: 15px;
    }
    .service .body-copy {
        font-size: 13px;
        line-height: 1.85;
    }
    ul {
        display: grid;
        gap: 12px;
        margin-block: 27px 30px;
    }
    li {
        display: flex;
        gap: 9px;
        align-items: center;
        font-size: 11px;
    }
    li span {
        color: var(--accent);
    }
    .mode {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid var(--line);
        padding-top: 18px;
        margin-top: auto;
        color: var(--muted);
        font-size: 8px;
        letter-spacing: 0.12em;
    }
    @media (max-width: 1000px) {
        .service {
            padding: 23px 20px;
        }
        .section-intro {
            gap: 30px;
        }
    }
    @media (max-width: 767px) {
        .section-intro {
            display: block;
        }
        .section-intro p {
            margin-top: 22px;
        }
        .services-grid {
            grid-template-columns: 1fr;
        }
        .service {
            padding: 28px;
        }
        .service-top {
            margin-bottom: 24px;
        }
    }
</style>
