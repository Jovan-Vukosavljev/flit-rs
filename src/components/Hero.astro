---
import type { Copy } from '../i18n';
import SupportDiagram from './SupportDiagram.astro';

interface Props {
    copy: Copy;
}
const { copy } = Astro.props;
---

<section class='shell hero' aria-labelledby='hero-heading'>
    <div class='hero-copy'>
        <p class='eyebrow flex items-center gap-3'>
            <span class='status-dot' aria-hidden='true'></span>{copy.hero.eyebrow}
        </p>
        <h1 id='hero-heading'>
            {copy.hero.first}<br /><span>{copy.hero.second}</span>
        </h1>
        <p class='body-copy hero-description'>{copy.hero.body}</p>
        <div class='hero-actions flex flex-wrap items-center gap-7'>
            <a class='button' href='#contact'
                >{copy.hero.action}<span
                    class='i-lucide-arrow-up-right size-4'
                    aria-hidden='true'></span></a
            >
            <a class='text-link' href='#services'
                >{copy.hero.secondary}<span
                    class='i-lucide-arrow-down size-4'
                    aria-hidden='true'></span></a
            >
        </div>
        <p class='hero-note'>
            <span class='i-lucide-map-pin size-3.5' aria-hidden='true'></span>{
                copy.hero.footnote
            }
        </p>
    </div>
    <div class='hero-art'><SupportDiagram copy={copy.hero} /></div>
</section>
<div class='service-strip'>
    <div class='shell strip-inner'>
        {
            copy.strip.map((item, index) => (
                <div>
                    <span
                        class:list={[
                            'size-4',
                            index === 0
                                ? 'i-lucide-globe'
                                : index === 1
                                  ? 'i-lucide-map-pin'
                                  : 'i-lucide-network',
                        ]}
                        aria-hidden='true'
                    />
                    {item}
                    <span class='strip-number' aria-hidden='true'>
                        0{index + 1}
                    </span>
                </div>
            ))
        }
    </div>
</div>
<style>
    .hero {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 50px;
        align-items: center;
        padding-block: 95px 88px;
    }
    h1 {
        font-size: clamp(38px, 4.35vw, 64px);
        font-weight: 500;
        line-height: 1.16;
        letter-spacing: -0.055em;
        margin-block: 26px 24px;
    }
    h1 span {
        color: var(--accent);
    }
    .hero-description {
        max-width: 450px;
    }
    .hero-actions {
        margin-top: 32px;
    }
    .hero-note {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        color: var(--muted);
        margin-top: 31px;
    }
    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
    }
    .service-strip {
        border-block: 1px solid var(--line);
    }
    .strip-inner {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
    }
    .strip-inner > div {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 24px 30px;
        color: var(--muted);
        font-size: 12px;
    }
    .strip-inner > div:first-child {
        padding-left: 0;
    }
    .strip-inner > div + div {
        border-left: 1px solid var(--line);
    }
    .strip-inner > div > span:first-child {
        color: var(--accent);
    }
    .strip-number {
        margin-left: auto;
        font-size: 9px;
    }
    @media (max-width: 1100px) {
        .hero {
            gap: 28px;
        }
        h1 {
            font-size: 44px;
        }
    }
    @media (max-width: 767px) {
        .hero {
            grid-template-columns: 1fr;
            padding-block: 55px 48px;
            gap: 40px;
        }
        h1 {
            font-size: clamp(35px, 7vw, 50px);
        }
        .hero-art {
            max-width: 480px;
            width: 100%;
            margin-inline: auto;
        }
        .strip-inner > div {
            padding: 18px 10px;
            font-size: 10px;
            gap: 7px;
        }
        .strip-number {
            display: none;
        }
    }
    @media (max-width: 380px) {
        .strip-inner > div {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
