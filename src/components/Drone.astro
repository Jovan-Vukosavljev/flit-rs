---
import { Picture } from 'astro:assets';
import { images } from '../config/images';
import type { Locale } from '../config/site';
import type { Copy } from '../i18n';
import DronePlaceholder from './DronePlaceholder.astro';

interface Props {
    locale: Locale;
    copy: Copy['drone'];
}
const { locale, copy } = Astro.props;
---

<section
    id='drone'
    class='shell section-space drone-grid'
    aria-labelledby='drone-heading'
>
    <div class='drone-visual'>
        {
            images.droneImage ? (
                <Picture
                    src={images.droneImage}
                    alt={images.droneImageAlt[locale]}
                    formats={['avif', 'webp']}
                    fallbackFormat='jpg'
                    widths={[400, 720, 1000, images.droneImage.width]}
                    sizes='(max-width: 767px) calc(100vw - 40px), (max-width: 1000px) calc(52.38vw - 71.24px), (max-width: 1336px) calc(52.38vw - 97.43px), 603px'
                    loading='lazy'
                    decoding='async'
                />
            ) : (
                <DronePlaceholder placeholder={copy.placeholder} note={copy.note} />
            )
        }
    </div>
    <div class='drone-copy'>
        <p class='eyebrow'>{copy.eyebrow}</p><h2
            id='drone-heading'
            class='section-title mt-5'
        >
            {copy.heading}
        </h2><p class='body-copy mt-6'>{copy.body}</p><ul
            class='flex flex-wrap gap-2 mt-6'
        >
            {copy.tags.map((tag) => <li>{tag}</li>)}
        </ul><a href='#contact' class='text-link mt-8'
            >{copy.action}<span
                class='i-lucide-arrow-up-right size-4'
                aria-hidden='true'></span></a
        >
    </div>
</section>
<style>
    .drone-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 90px;
        align-items: center;
    }
    .drone-visual {
        position: relative;
        aspect-ratio: 1.2;
        border-radius: 6px;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--line);
    }
    .drone-visual :global(picture) {
        display: block;
        width: 100%;
        height: 100%;
    }
    .drone-visual :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    li {
        border: 1px solid var(--line);
        border-radius: 3px;
        padding: 7px 11px;
        font-size: 10px;
        color: var(--muted);
    }
    @media (max-width: 1000px) {
        .drone-grid {
            gap: 40px;
        }
    }
    @media (max-width: 767px) {
        .drone-grid {
            grid-template-columns: 1fr;
            gap: 34px;
        }
        .drone-copy {
            order: -1;
        }
    }
</style>
