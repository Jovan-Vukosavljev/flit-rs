---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <meta name='description' content='Flit, built with Astro and Svelte.' />
        <title>{title}</title>
    </head>
    <body class='min-h-screen bg-stone-100 text-stone-900 antialiased'>
        <slot />
    </body>
</html>
